# Spendly environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Postgres connection string (Neon recommended).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public base URL of the running app. Used by Better Auth (server) to build
# callback URLs and absolute links. Better Auth reads this automatically.
# Local dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Client-side base URL for the Better Auth client. Must be a NEXT_PUBLIC_
# var so it is exposed to the browser. Should match BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only AES-256-GCM key used to encrypt integration credentials
# (e.g. the Notion internal integration token). Must be 32 bytes, base64
# encoded. Generate with:
#   openssl rand -base64 32
SPENDLY_ENCRYPTION_KEY=""

# Notion integration (optional in V0 — used only when exercising the
# real Notion API locally). The user supplies their own token through the
# Connections UI; this is not required to run the app.
# NOTION_API_VERSION="2022-06-28"

# ── Observability (Axiom) ───────────────────────────────────────────────
# External log storage for production debugging. Optional in local dev and
# CI: when these are absent, logs fall back to the console sink only and the
# app builds/runs normally. See docs/observability.md.
#
# AXIOM_DATASET — Axiom dataset name (create one in Axiom, e.g. "spendly-prod").
#                 Free tier allows up to 3 datasets.
# AXIOM_TOKEN   — Axiom API token with Ingest permission on the dataset.
#                 Create at Axiom → Settings → API Tokens. Server-only; never
#                 prefix with NEXT_PUBLIC_.
# AXIOM_URL     — Optional ingest base URL. Defaults to https://api.axiom.co.
#                 Override only for Axiom Cloud regional/private endpoints.
#
# Configure these in Vercel Project Settings → Environment Variables for the
# Production environment. Never commit real token values.
AXIOM_DATASET=""
AXIOM_TOKEN=""
# AXIOM_URL="https://api.axiom.co"
